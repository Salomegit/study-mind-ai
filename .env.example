# Public hostname only: no https:// and no trailing slash.
# For a temporary HTTP-only test by IP address, use DOMAIN=:80.
DOMAIN=study.example.com

# The browser calls the API through Caddy on the same domain.
NEXT_PUBLIC_API_URL=/api

# Copy these values from your existing frontend/.env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
